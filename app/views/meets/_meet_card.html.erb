<div class="M_MeetCard" id="<%= dom_id(meet) %>" data-controller="meet-card" data-meet-id="<%= meet.id %>" data-action="click->meet-card#navigate">
  <div class="M_MeetContent">
    <div class="M_MeetHeader">
      <div class="M_MeetUserInfo">
        <div class="A_MeetAvatar">
          <% if meet.user.profile&.avatar.present? %>
            <%= image_tag meet.user.profile.avatar.url, alt: meet.user.username %>
          <% else %>
            <div class="A_MeetAvatarPlaceholder" style="<%= avatar_placeholder_style(meet.user) %>">
            </div>
          <% end %>
        </div>
        <div class="M_MeetUserDetails">
          <p class="A_MeetAuthor">@<%= meet.user.username %></p>
          <time class="A_MeetTimestamp"><%= time_ago_in_words(meet.created_at) %> назад</time>
        </div>
      </div>
      
      <% if user_signed_in? %>
        <%= link_to favourite_toggle_path(type: meet.class.name, id: meet.id), 
                    class: "Q_BookmarkIconNoBg #{meet.favourites.exists?(user_id: current_user.id) ? 'active' : ''}", 
                    data: { turbo_method: :post },
                    id: dom_id(meet, "bookmark") do %>
          <%= render 'shared/icon_save', active: meet.favourites.exists?(user_id: current_user.id) %>
        <% end %>
      <% end %>
    </div>
    
    <p class="A_MeetText"><%= meet.body %></p>
    
    <div class="M_MeetDateTime">
      <span class="A_MeetDateTimeBlock">
        <i class="fas fa-calendar-alt"></i><%= l(meet.hosted_at, format: :meet_date_time) %>
      </span>
      <span class="A_MeetDateTimeBlock">
        <i class="fas fa-comment"></i><%= meet.comments.count %>
      </span>
    </div>
  </div>
</div>