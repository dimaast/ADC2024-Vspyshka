<div class="MeetForm">
  <%= form_with(model: meet, class: "MeetForm__form") do |form| %>
    <% if meet.errors.any? %>
      <div class="MeetForm__errors">
        <h3>Ошибки при сохранении встречи:</h3>
        <ul>
          <% meet.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="MeetForm__layout">
      <!-- Левая колонка: Теги -->
      <div class="MeetForm__left">
        <!-- Добавить теги -->
        <button type="button" class="MeetForm__tags-button">
          <i class="fas fa-plus"></i>
          Добавить теги
        </button>
      </div>

      <!-- Правая колонка: Детали встречи -->
      <div class="MeetForm__right">
        <!-- Заголовок -->
        <h1 class="A_FormTitle">СОЗДАНИЕ ВСТРЕЧИ</h1>

        <!-- Поля формы -->
        <div class="MeetForm__fields">
          <!-- Дата и время -->
          <div class="MeetForm__field">
            <div class="MeetForm__input-group">
              <i class="fas fa-calendar-alt MeetForm__input-icon"></i>
              <%= form.datetime_field :hosted_at, min: Date.today, class: "MeetForm__input", placeholder: "Дата и время" %>
            </div>
          </div>

          <!-- Место проведения -->
          <div class="MeetForm__field">
            <div class="MeetForm__input-group">
              <i class="fas fa-map-marker-alt MeetForm__input-icon"></i>
              <%= form.text_field :placed_at, class: "MeetForm__input", placeholder: "Место проведения" %>
              <i class="fas fa-chevron-down MeetForm__input-arrow"></i>
            </div>
          </div>

          <!-- Подробности о месте -->
          <div class="MeetForm__field">
            <div class="MeetForm__input-group">
              <%= form.text_field :placed_additional, class: "MeetForm__input", placeholder: "Подробности о месте" %>
              <i class="fas fa-info-circle MeetForm__input-info"></i>
            </div>
          </div>
        </div>

        <!-- Описание встречи -->
        <div class="MeetForm__description-section">
          <label class="MeetForm__description-label">О встрече</label>
          <%= form.text_area :body, class: "MeetForm__textarea", placeholder: "Введите описание встречи" %>
        </div>

        <!-- Кнопка публикации -->
        <div class="MeetForm__actions">
          <%= form.submit 'Опубликовать', class: "MeetForm__submit" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
