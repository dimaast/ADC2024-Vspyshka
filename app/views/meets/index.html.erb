<% set_meta_tags( 
  title: "Встречи",
  description: "Студенческие встречи в Вышке", 
  keywords: "Студорги, Студенческие организации, События, Встречи, Мероприятия, Ивенты, Тусовки, Вышка, НИУ ВШЭ, ВШЭ" )%>

<div class="communities-title-container">
  <h1 class="communities-title">Встречи</h1>
</div>

<div class="meets-controls-container">
  <div class="filters-section">
    <form method="get" action="<%= meets_path %>" class="events-filter-form">
      <div class="filter-row">
        <div class="filter-field">
          <div class="place-selector <%= 'default-state' if params[:place].blank? %>">
            <i class="fas fa-map-marker-alt"></i>
            <select name="place" id="place" onchange="this.form.submit()">
              <option value="">Все места</option>
              <% ['Онлайн', 'Корпус 1', 'Корпус 2', 'Корпус 3', 'Корпус 4', 'Другое'].each do |place| %>
                <option value="<%= place %>" <%= 'selected' if params[:place] == place %>><%= place %></option>
              <% end %>
            </select>
            <i class="fas fa-chevron-down"></i>
          </div>
        </div>
        
        <div class="filter-field">
          <input type="date" name="date" id="date" value="<%= params[:date] %>" onchange="this.form.submit()" class="A_DateInput">
        </div>
      </div>
    </form>
  </div>
  
  <div class="sort-section">
    <%= link_to meets_path(sort: 'popular'), class: "sort-option #{'active' if params[:sort] == 'popular' || params[:sort].blank?}", data: { turbo_frame: 'meets_list' } do %>
      <i class="fas fa-chart-line"></i>
      <span>Отсортировать по популярности</span>
    <% end %>
    
    <%= link_to meets_path(sort: 'new'), class: "sort-option #{'active' if params[:sort] == 'new'}", data: { turbo_frame: 'meets_list' } do %>
      <i class="fas fa-calendar-alt"></i>
      <span>Отсортировать по дате</span>
    <% end %>
  </div>
</div>

<turbo-frame id="meets_list">
  <div class="C_EventsAndMeets">
    <% @meets.first(6).each do |meet| %>
      <div class="M_MeetCardOuter">
        <%= render partial: 'meets/meet_card', locals: { meet: meet } %>
        <div class="C_Tags">
          <% meet.tags.each do |tag| %>
            <%= link_to tag.name, tagged_meets_path(tag.name), class: 'A_Tag' %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</turbo-frame>


<turbo-frame id="meets_list_second">
  <div class="C_EventsAndMeets">
    <% @meets.offset(6).each do |meet| %>
      <%= link_to meet_path(meet), class: "M_MeetCardLink" do %>
        <div class="M_MeetCardOuter">
          <%= render partial: 'meets/meet_card', locals: { meet: meet } %>
          <div class="C_Tags">
            <% meet.tags.each do |tag| %>
              <%= link_to tag.name, tagged_meets_path(tag.name), class: 'A_Tag' %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</turbo-frame>

<div class="pagination-wrapper">
  <%= paginate @meets %>
</div>