<h1 class="O_SettingsPageTitle">Настройки</h1>

<nav class="O_SettingsTabs">
  <ul>
    <li><a href="#settings-profile">Настройки профиля</a></li>
    <li><a href="#settings-account">Данные об аккаунте</a></li>
    <li><a href="#settings-privacy">Приватность</a></li>
    <li><a href="#settings-support">Поддержка</a></li>
  </ul>
</nav>

<div id="settings-profile" class="O_SettingsSection">
  <div class="O_SettingsSection__header">
    <span class="O_SettingsSection__title">Настройки профиля</span>
    <button type="button" class="O_SettingsSection__edit-button">
      <div class="Q_Icon Q_IconEdit IconEdit"></div>
    </button>
  </div>

  <div class="O_SettingsSection__body">
    <%= form_with model: current_user.profile,
                  url: profile_path(current_user.profile),
                  method: :patch,
                  local: true do |f| %>

      <div class="O_FormRow">
        <%= f.label :avatar, "Фото", class: "O_FormRow__label" %>
        <div class="O_FormRow__field">
          <%= f.file_field :avatar, class: "O_FormInput" %>

          <% if current_user.profile&.avatar? %>
            <%= image_tag current_user.profile.avatar.url,
                          alt:   "Аватар пользователя",
                          class: "ProfileAvatar" %>
          <% else %>
            <div class="ProfileAvatar ProfileAvatar--placeholder profile-avatar-placeholder" style="<%= avatar_placeholder_style(current_user) %>">
            </div>
          <% end %>
        </div>
      </div>

      <div class="O_FormRow">
        <%= f.label :last_name, "Фамилия", class: "O_FormRow__label" %>
        <div class="O_FormRow__field">
          <%= f.text_field :last_name,
                           class:       "O_FormInput",
                           placeholder: "Введите фамилию" %>
        </div>
      </div>

      <div class="O_FormRow">
        <%= f.label :first_name, "Имя", class: "O_FormRow__label" %>
        <div class="O_FormRow__field">
          <%= f.text_field :first_name,
                           class:       "O_FormInput",
                           placeholder: "Введите имя" %>
        </div>
      </div>

      <div class="O_FormRow">
        <%= f.label :patronymic, "Отчество", class: "O_FormRow__label" %>
        <div class="O_FormRow__field">
          <%= f.text_field :patronymic,
                           class:       "O_FormInput",
                           placeholder: "Введите отчество" %>
        </div>
      </div>

      <div class="O_FormRow">
        <%= f.label :telegram_username, "Telegram", class: "O_FormRow__label" %>
        <div class="O_FormRow__field">
          <%= f.text_field :telegram_username,
                           class:       "O_FormInput",
                           placeholder: "Например: ananchousova" %>
        </div>
      </div>

      <div class="O_FormRow">
        <%= f.label :faculty_id, "Факультет", class: "O_FormRow__label" %>
        <div class="O_FormRow__field">
          <%= f.collection_select :faculty_id,
                                  Faculty.all.order(:name),
                                  :id,
                                  :name,
                                  { prompt: "— Не выбрано —" },
                                  class: "O_FormInput" %>
        </div>
      </div>

      <div class="O_FormRow">
        <%= f.label :program_id, "Программа", class: "O_FormRow__label" %>
        <div class="O_FormRow__field">
          <%= f.collection_select :program_id,
                                  Program.all.order(:name),
                                  :id,
                                  :name,
                                  { prompt: "— Не выбрано —" },
                                  class: "O_FormInput" %>
        </div>
      </div>

      <div class="O_FormRow O_FormRow--actions">
        <%= f.submit "Сохранить", class: "A_Button" %>
      </div>
    <% end %>

    <div class="O_FormRow O_FormRow--delete">
      <%= button_to "Удалить аккаунт",
        user_registration_path,
        method: :delete,
        data: { confirm: "Вы уверены, что хотите удалить аккаунт? Это действие нельзя отменить." },
        class: "A_Button A_Button--danger" %>
    </div>
  </div>
</div>

<hr class="SectionDivider" />

<div id="settings-account" class="O_SettingsSection">
  <div class="O_SettingsSection__header">
    <span class="O_SettingsSection__title">Данные об аккаунте</span>
    <button type="button" class="O_SettingsSection__edit-button">
      <div class="Q_Icon Q_IconEdit IconEdit"></div>
    </button>
  </div>

  <div class="O_SettingsSection__body">
    <div class="O_SettingRow">
      <span class="O_SettingRow__label">Почта</span>
      <span class="O_SettingRow__value"><%= current_user.email %></span>
    </div>
    <div class="O_SettingRow">
      <span class="O_SettingRow__label">Факультет</span>
      <span class="O_SettingRow__value">
        <%= current_user.profile&.faculty&.name.presence || "Не указано" %>
      </span>
    </div>
    <div class="O_SettingRow">
      <span class="O_SettingRow__label">Программа</span>
      <span class="O_SettingRow__value">
        <%= current_user.profile&.program&.name.presence || "Не указано" %>
      </span>
    </div>
  </div>
</div>

<hr class="SectionDivider" />

<div id="settings-privacy" class="O_SettingsSection">
  <div class="O_SettingsSection__header">
    <span class="O_SettingsSection__title">Приватность</span>
    <button type="button" class="O_SettingsSection__edit-button">
      <div class="Q_Icon Q_IconEdit IconEdit"></div>
    </button>
  </div>

  <div class="O_SettingsSection__body">
    <div class="O_SettingRow">
      <span class="O_SettingRow__label">Кому видны события</span>
      <span class="O_SettingRow__value">Не задано</span>
    </div>
    <div class="O_SettingRow">
      <span class="O_SettingRow__label">Кому видны встречи</span>
      <span class="O_SettingRow__value">Не задано</span>
    </div>
    <div class="O_SettingRow">
      <span class="O_SettingRow__label">Кому видны сообщества</span>
      <span class="O_SettingRow__value">Не задано</span>
    </div>
    <div class="O_SettingRow">
      <span class="O_SettingRow__label">Пользователи, которым ограничен доступ</span>
      <span class="O_SettingRow__value">0</span>
    </div>
  </div>
</div>

<hr class="SectionDivider" />

<div id="settings-support" class="O_SettingsSection">
  <div class="O_SettingsSection__header">
    <span class="O_SettingsSection__title">Поддержка</span>
    <button type="button" class="O_SettingsSection__edit-button">
      <div class="Q_Icon Q_IconEdit IconEdit"></div>
    </button>
  </div>

  <div class="O_SettingsSection__body">
    <%= form_with url: support_messages_path, method: :post, local: true do |f| %>
      <div class="O_FormRow">
        <%= f.label :message, "Сообщение", class: "O_FormRow__label" %>
        <div class="O_FormRow__field">
          <%= f.text_area :message,
                          rows:        4,
                          placeholder: "Опишите проблему или вопрос",
                          class:       "O_FormInput" %>
        </div>
      </div>
      <div class="O_FormRow O_FormRow--actions">
        <%= f.submit "Отправить", class: "A_Button" %>
      </div>
    <% end %>
  </div>
</div>

<hr class="SectionDivider" />

<div class="O_FormRow O_FormRow--logout">
  <%= link_to "Выйти",
              destroy_user_session_path,
              method: :delete,
              class: "A_Button" %>
</div>