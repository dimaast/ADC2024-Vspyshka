<div class="auth-container">
  <div class="auth-form">
    <h2>Сменить пароль</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field">
        <%= f.label :password, "Новый пароль" %>
        <% if @minimum_password_length %>
          <em>(<%= @minimum_password_length %> символов минимум)</em>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "Введите новый пароль" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Подтвердить пароль" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Повторите новый пароль" %>
      </div>

      <div class="actions">
        <%= f.submit "Сменить пароль" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
