<div class="auth-container">
  <div class="auth-form">
    <h2>Забыли пароль?</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email, "Почта" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Введите вашу почту" %>
      </div>

      <div class="actions">
        <%= f.submit "Сбросить пароль" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
