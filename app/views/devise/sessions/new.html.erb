<div class="O_AuthContainer">
  <div class="M_AuthForm">
    <h2>ВХОД</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="M_AuthField">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Корпоративная почта" %>
      </div>

      <div class="M_AuthField">
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "Пароль" %>
      </div>

      <div class="M_AuthFieldForgot">
        <%= link_to "Забыли пароль?", new_password_path(resource_name) %>
      </div>

      <div class="M_AuthActions">
        <%= f.submit "Войти" %>
      </div>
    <% end %>

    <div class="C_AuthLinks">
      <p>Еще нет аккаунта? <%= link_to "Зарегистрироваться", new_registration_path(resource_name) %></p>
    </div>
  </div>
</div>