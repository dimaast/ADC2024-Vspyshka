<div class="auth-container">
  <div class="auth-form">
    <h2>Войти</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :email, "Почта" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Введите вашу почту" %>
      </div>

      <div class="field">
        <%= f.label :password, "Пароль" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "Введите ваш пароль" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field checkbox">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "Запомнить меня" %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "Войти" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
