<div class="CommentsList" id="C_Comments">
  <% if comments.any? %>
    <% comments.no_replies.each do |comment| %>
      <div class="CommentItem">
        <%= render "comments/comment", comment: comment, commentable: comment.commentable %>
      </div>
    <% end %>
  <% else %>
    <div class="EmptyComments">
      <p>Пока нет комментариев. Будьте первым!</p>
    </div>
  <% end %>
</div> 