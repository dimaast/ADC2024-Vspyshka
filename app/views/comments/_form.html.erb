<div class="M_CommentForm">

  <% if user_signed_in? %>
    <%= form_with(model: [commentable, comment], data: { turbo_stream: true }) do |form| %>
      <% if comment.errors.any? %>
        <div class="M_CommentForm__errors">
          <h4>Найдены ошибки:</h4>
          <ul>
            <% comment.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="M_CommentForm__input-group">
        <%= form.text_area :body, 
                          class: "M_CommentForm__textarea",
                          placeholder: "Написать комментарий",
                          rows: 1 %>
        <button type="submit" class="M_CommentForm__submit-icon" title="Отправить комментарий">
          <%= image_tag "icons/IconSend.svg", alt: "Отправить", class: "M_CommentForm__send-icon" %>
        </button>
      </div>

      <% if defined? parent_comment_id %>
        <%= form.hidden_field :comment_id, value: parent_comment_id %>
      <% end %>
    <% end %>
  <% else %>
    <div class="M_CommentForm__login-prompt">
      <p>Чтобы оставить комментарий, пожалуйста, <a href="<%= new_user_session_path %>">войдите в систему</a> или <a href="<%= new_user_registration_path %>">зарегистрируйтесь</a>.</p>
    </div>
  <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {

  document.addEventListener('turbo:submit-end', function(event) {
    if (event.detail.success) {
      const form = event.target;
      const textarea = form.querySelector('.M_CommentForm__textarea');
      if (textarea) {
        textarea.value = '';
        textarea.style.height = 'auto';
      }
    }
  });
});
</script>