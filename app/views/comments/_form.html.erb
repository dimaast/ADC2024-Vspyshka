<div class="CommentForm">
  <div class="CommentForm__header">
    <% if user_signed_in? %>
      <% if current_user.profile&.avatar&.present? %>
        <%= image_tag current_user.profile.avatar.url, class: "CommentForm__avatar", alt: current_user.username %>
      <% else %>
        <div class="CommentForm__avatar-placeholder" style="<%= avatar_placeholder_style(current_user) %>">
          <%= current_user.username.first.upcase %>
        </div>
      <% end %>
      <h3 class="CommentForm__title">
        <%= defined?(parent_comment_id) ? "Ответить на комментарий" : "Добавить комментарий" %>
      </h3>
    <% else %>
      <div class="CommentForm__avatar-placeholder">
        ?
      </div>
      <h3 class="CommentForm__title">
        Войдите, чтобы оставить комментарий
      </h3>
    <% end %>
  </div>

  <% if user_signed_in? %>
    <%= form_with(model: [commentable, comment], data: { turbo_stream: true }) do |form| %>
      <% if comment.errors.any? %>
        <div class="CommentForm__errors">
          <h4>Найдены ошибки:</h4>
          <ul>
            <% comment.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.text_area :body, 
                          class: "CommentForm__textarea",
                          placeholder: "Напишите ваш комментарий...",
                          rows: 4 %>
      </div>

      <% if defined? parent_comment_id %>
        <%= form.hidden_field :comment_id, value: parent_comment_id %>
      <% end %>

      <div class="CommentForm__actions">
        <%= link_to "Отмена", "#", class: "CommentForm__cancel", onclick: "this.closest('.CommentForm').style.display='none'; return false;" %>
        <%= form.submit "Отправить", class: "CommentForm__submit" %>
      </div>
    <% end %>
  <% else %>
    <div class="CommentForm__login-prompt">
      <p>Чтобы оставить комментарий, пожалуйста, <a href="<%= new_user_session_path %>">войдите в систему</a> или <a href="<%= new_user_registration_path %>">зарегистрируйтесь</a>.</p>
    </div>
  <% end %>
</div>