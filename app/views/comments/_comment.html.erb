<div class="M_Comment <%= "M_Comment--reply" if comment.comment_id != nil %>" id="<%= dom_id comment %>">
    <div class="M_Comment__main">
      
      <% if comment.user.profile&.avatar&.present? %>
        <%= link_to profile_path(comment.user.profile) do %>
          <%= image_tag comment.user.profile.avatar.url, class: "M_Comment__avatar", alt: "@#{comment.user.username}" %>
        <% end %>
      <% else %>
        <%= link_to profile_path(comment.user.profile) do %>
          <div class="M_Comment__avatar-placeholder comment-avatar-placeholder" style="<%= avatar_placeholder_style(comment.user) %>">
          </div>
        <% end %>
      <% end %>
      
      <div class="M_Comment__content-wrapper">
        <div class="M_Comment__header">
          <div class="M_Comment__user-info">
            
            <div class="A_CommentUsername">
              <%= link_to "@#{comment.user.username}", 
                          profile_path(comment.user.profile), 
                          style: "color: inherit; text-decoration: none;" %>
            </div>

            <% if comment.comment_id.present? %>
              <div class="A_CommentReplyInfo">
                ответ @<%= Comment.find(comment.comment_id).user.username %>
              </div>
            <% end %>
          </div>

          <% if can? :manage, comment %>
            <div class="M_Comment__actions-top">
              <%= link_to edit_event_comment_path(comment.commentable, comment), 
                          class: "M_Comment__edit-btn", 
                          title: "Редактировать" do %>
                <%= image_tag "icons/IconEditComment.svg", alt: "Редактировать", class: "M_Comment__edit-icon" %>
              <% end %>
              
              <%= button_to [comment.commentable, comment], 
                          method: :delete, 
                          data: { turbo_confirm: "Вы уверены?" },
                          class: "M_Comment__delete-btn",
                          title: "Удалить",
                          form: { data: { turbo_stream: true } } do %>
                <%= image_tag "icons/IconDeleteComment.svg", alt: "Удалить", class: "M_Comment__delete-icon" %>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="A_CommentContent">
          <%= simple_format(comment.body) %>
        </div>
      </div>
    </div>

    <div class="M_CommentActions">
      
      <%= render partial: "comments/like_button", locals: { comment: comment } %>

      <% if user_signed_in? %>
        <button class="A_CommentAction ReplyButton" onclick="toggleReplyForm('<%= dom_id comment %>')">
          Ответить
        </button>
      <% end %>

      <div class="A_CommentTimestamp A_CommentTimestamp--bottom">
        <%= time_ago_in_words(comment.created_at) %>
      </div>
    </div>

    <% if user_signed_in? %>
      <div id="reply-form-<%= dom_id comment %>" class="ReplyForm reply-form-hidden">
        <%= render partial: "comments/form", 
                   locals: { comment: Comment.new, 
                            commentable: comment.commentable, 
                            parent_comment_id: comment.id } %>
      </div>
    <% end %>

    <div class="M_Comment__divider"></div>

    <% if comment.replies.any? %>
      <div class="M_CommentReplies">
        <% comment.replies.each do |reply| %>
          <div class="M_CommentReply">
            <%= render "comments/comment", comment: reply %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <script>
  function toggleReplyForm(commentId) {
    const form = document.getElementById('reply-form-' + commentId);
    if (form.style.display === 'none') {
      form.style.display = 'block';
    } else {
      form.style.display = 'none';
    }
  }
  </script>
</div>