<!-- Главная страница с новым дизайном -->
<div class="homepage-container">
  <!-- Секция ближайших событий -->
  <section class="upcoming-events-section">
    <div class="section-header">
      <h2 class="section-title">БЛИЖАЙШИЕ СОБЫТИЯ</h2>
    </div>
    
    <div class="C_EventsAndMeets">
      <% @upcoming_events.each_with_index do |event, index| %>
        <%= link_to event_path(event), class: "event-card-link" do %>
          <div class="event-card">
            <div class="event-image">
              <% if event.cover.present? %>
                <%= image_tag event.cover.url, alt: event.title %>
              <% else %>
                <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                  <%= event.title.first(10) %>
                </div>
              <% end %>
              
              <div class="Q_BookmarkIconNoBg">
                <%= render 'shared/icon_save', active: false %>
              </div>
            </div>
            
            <div class="event-content">
              <h3 class="event-title"><%= event.title %></h3>
              <p class="event-date"><%= l(event.hosted_at.to_date, format: :short) %></p>
              <div class="event-meta">
                <p class="event-organizer"><%= event.user.username %></p>
                <div class="event-tag">
                  <%= event.category_list.first || "Событие" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- Секция ближайших встреч -->
  <section class="upcoming-meetings-section">
    <div class="section-header">
      <h2 class="section-title">БЛИЖАЙШИЕ ВСТРЕЧИ</h2>
    </div>
    
    <div class="C_EventsAndMeets">
      <% @upcoming_meets.each do |meet| %>
        <div class="M_MeetCardOuter">
          <%= render partial: 'meets/meet_card', locals: { meet: meet } %>
          <div class="C_Tags">
            <% meet.tags.each do |tag| %>
              <%= link_to tag.name, tagged_meets_path(tag.name), class: 'A_Tag' %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Секция рейтинга сообществ -->
  <section class="communities-rating-section">
    <div class="section-header">
      <h2 class="section-title">РЕЙТИНГ СООБЩЕСТВ</h2>
    </div>
    
    <div class="communities-cards-container">
      <% @top_communities.each do |community| %>
        <%= render partial: 'communities/community', locals: { community: community } %>
      <% end %>
    </div>
  </section>


  <!-- Секция последних публикаций -->
  <section class="publications-section">
    <div class="section-header">
      <h2 class="section-title">ПОСЛЕДНИЕ ПУБЛИКАЦИИ</h2>
      <div class="publication-tabs">
        <%= link_to "События", root_path(publication_type: 'events'), 
            class: "publication-tab #{'active' if @publication_type == 'events'}" %>
        <%= link_to "Встречи", root_path(publication_type: 'meets'), 
            class: "publication-tab #{'active' if @publication_type == 'meets'}" %>
      </div>
    </div>
    
    <div class="C_EventsAndMeets">
      <% @recent_publications.each do |publication| %>
        <% if @publication_type == 'events' %>
          <%= link_to event_path(publication), class: "event-card-link" do %>
            <div class="event-card">
              <div class="event-image">
                <% if publication.cover.present? %>
                  <%= image_tag publication.cover.url, alt: publication.title %>
                <% else %>
                  <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                    <%= publication.title.first(10) %>
                  </div>
                <% end %>
                
                <div class="Q_BookmarkIconNoBg">
                  <%= render 'shared/icon_save', active: false %>
                </div>
              </div>
              
              <div class="event-content">
                <h3 class="event-title"><%= publication.title %></h3>
                <p class="event-date"><%= l(publication.hosted_at.to_date, format: :short) %></p>
                <div class="event-meta">
                  <p class="event-organizer"><%= publication.user.username %></p>
                  <div class="event-tag">
                    <%= publication.category_list.first || "Событие" %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <!-- Для встреч используем унифицированную структуру -->
          <div class="M_MeetCardOuter">
            <%= render partial: 'meets/meet_card', locals: { meet: publication } %>
            <div class="C_Tags">
              <% publication.tags.each do |tag| %>
                <%= link_to tag.name, tagged_meets_path(tag.name), class: 'A_Tag' %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
</div>


