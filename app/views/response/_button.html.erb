<% if user_signed_in? %>
  <%
    response = responseable.responses.where(user_id: current_user.id)
    button_text = response && response.count > 0 ? "Отменить участие" : "Участвовать"
  %>
  <% unless content_for?(:events_list) %>
    <turbo-frame id="response_button_<%= responseable.class.name.downcase %>_<%= responseable.id %>">
  <% end %>
    <%= link_to button_text, response_toggle_path(type: responseable.class, id: responseable.id), data: { turbo_stream: true }, class: "A_EventShowFollowBtn" %>
  <% unless content_for?(:events_list) %>
    </turbo-frame>
  <% end %>
<% end %>