<%= form_with(model: profile) do |form| %>
  <% if profile.errors.any? %>
    <div class="error-message">
      <h2><%= pluralize(profile.errors.count, "error") %> prohibited this profile from being saved:</h2>

      <ul>
        <% profile.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :last_name, "Фамилия", style: "display: block" %>
    <%= form.text_field :last_name %>
  </div>

  <div>
    <%= form.label :first_name, "Имя", style: "display: block" %>
    <%= form.text_field :first_name %>
  </div>

  <div>
    <%= form.label :middle_name, "Отчество", style: "display: block" %>
    <%= form.text_field :middle_name %>
  </div>

  <div>
    <%= form.label :body, "О себе", style: "display: block" %>
    <%= form.text_area :body %>
  </div>

  <div>
    <%= form.label :contact, "Контакты", style: "display: block" %>
    <%= form.text_field :contact %>
  </div>

  <div>
    <%= form.label :avatar, "Аватар", style: "display: block" %>
    <%= form.file_field :avatar %>
  </div>

  <div>
    <%= form.label :username, "Никнейм", style: "display: block" %>
    <%= text_field_tag :username, profile.user.username, name: 'profile[username]' %>
  </div>

  <div>
    <%= link_to 'Изменить интересы (визуально)', choose_interests_path, class: 'A_Button', style: 'margin-bottom: 16px;' %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>