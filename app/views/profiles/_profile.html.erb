<div id="<%= dom_id profile %>">
  <h2><%= profile.user.username %> (<%= profile.full_name %>)</h2>
  <%= image_tag profile.avatar.url, width: 100 if profile.avatar.present? %>
  <% unless profile.avatar.present? %>
    <div class="ProfileAvatar ProfileAvatar--placeholder" style="<%= avatar_placeholder_style(profile.user) %>; width: 100px; height: 100px; display: flex; align-items: center; justify-content: center; font-size: 48px; color: #fff;">
      <%= profile.user.username.first.upcase %>
    </div>
  <% end %>

  <p>
    <strong>ФИО:</strong>
    <%= profile.full_name %>
  </p>

  <p>
    <strong>Никнейм:</strong>
    <%= profile.user.username %>
  </p>

  <% if profile.body.present? %>
    <p>
      <strong>О себе:</strong>
      <%= profile.body %>
    </p>
  <% end %>

  <% if profile.contact.present? %>
    <p>
      <strong>Контакты:</strong>
      <%= profile.contact %>
    </p>
  <% end %>

</div>
