<% set_meta_tags( 
  title: @event.title,
  description: @event.body, 
  keywords: "Студорги, Студенческие организации, События, Мероприятия, Ивенты, Тусовки, Вышка, НИУ ВШЭ, ВШЭ" )%>

<div class="EventShow">
  <div class="EventShow__left">
    <div class="EventShow__poster">
      <% if @event.cover.present? %>
        <%= image_tag @event.cover.url, alt: @event.title %>
      <% else %>
        <div class="EventShow__poster--stub"></div>
      <% end %>
    </div>
    <div class="EventShow__host">
      <span>Проводит</span>
      <div class="EventShow__host-info">
        <% if @event.community.present? %>
          <span class="EventShow__host-avatar--stub"></span>
        <% elsif @event.user&.profile&.avatar&.present? %>
          <%= image_tag @event.user.profile.avatar.url, class: "EventShow__host-avatar" %>
        <% end %>
        <span>
          <%= @event.community.present? ? @event.community.title : (@event.user&.profile&.name || @event.user&.username || '—') %>
        </span>
        <span class="EventShow__host-label">Детали</span>
      </div>
    </div>
    <div class="EventShow__going">
      <span>Идут</span>
      <div class="EventShow__avatars">
        <% @event.responses.includes(:user).limit(3).each do |response| %>
          <% if response.user&.profile&.avatar&.present? %>
            <%= image_tag response.user.profile.avatar.url, class: "EventShow__avatar" %>
          <% end %>
        <% end %>
        <% if @event.responses.count > 3 %>
          <span class="EventShow__more">и еще <%= @event.responses.count - 3 %></span>
        <% end %>
      </div>
    </div>
    <%= link_to "Пожаловаться на событие", new_event_report_path(@event), class: "EventShow__report" %>
  </div>

  <div class="EventShow__right">
    <h1 class="EventShow__title"><%= @event.title %></h1>
    <div class="EventShow__info">
      <div>
        <i class="fas fa-calendar"></i>
        <%= l @event.hosted_at, format: :long %>
      </div>
      <div>
        <i class="fas fa-map-marker-alt"></i>
        <%= [@event.placed_at, @event.placed_additional].compact.join(', ') %>
      </div>
      <div>
        <i class="fas fa-money-bill"></i>
        <%= @event.price.present? ? @event.price : "бесплатно" %>
      </div>
    </div>
    
    <%# Кнопки действий %>
    <div class="EventShow__actions">
      <%# Кнопка лайка %>
      <%= render "favourite/button", favouriteable: @event %>
      
      <%# Кнопка отклика %>
      <%= render "response/button", responseable: @event %>
    </div>
    
    <div class="EventShow__description">
      <%= simple_format @event.body %>
    </div>
    <div class="EventShow__comments">
      <h2>Обсуждение</h2>
      <%= render "comments/comments", comments: @event.comments %>
      
      <%# Оставить комментарий %>
      <h3>Добавить комментарий:</h3>
      <%= render "comments/form", comment: Comment.new, commentable: @event %>
    </div>
  </div>
</div>

<%# Статистика %>
<div class="EventShow__stats">
  <p>Откликнулось: <%= @event.responses.count %></p>
  <p>Поставлено лайков: <%= @event.favourites.count %></p>
</div>

<%# Список лайкнувших %>
<% if @event.favourites.any? %>
  <div class="EventShow__favourites">
    <h3>Лайки от:</h3>
    <% @event.favourites.includes(:user).each do |favourite| %>
      <%= favourite.user&.profile&.name || favourite.user&.username || '—' %>
    <% end %>
  </div>
<% else %>
  <p>Никто не лайкнул</p>
<% end %>

<%# Список откликнувшихся %>
<% if @event.responses.any? %>
  <div class="EventShow__responses">
    <h3>Отклики от:</h3>
    <% @event.responses.includes(:user).each do |response| %>
      <%= response.user&.profile&.name || response.user&.username || '—' %>
    <% end %>
  </div>
<% else %>
  <p>Никто не откликнулся</p>
<% end %>

<%# Редактировать и удалять ивент %>
<div class="EventShow__admin">
  <%= link_to "Back to events", events_path %>
  <% if can? [:manage], @event %>
    <%= link_to "Edit this event", edit_event_path(@event) %>
    <%= button_to "Destroy this event", @event, method: :delete %>
  <% end %>
</div>

<%= turbo_stream_from @event, :comments %>