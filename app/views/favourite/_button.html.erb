<% if user_signed_in? %>
  <%= link_to favourite_toggle_path(type: favouriteable.class.name, id: favouriteable.id),
              class: "Q_BookmarkIconNoBg #{favouriteable.favourites.exists?(user_id: current_user.id) ? 'active' : ''}",
              data: { turbo_method: :post },
              id: dom_id(favouriteable, "bookmark") do %>
    <%= render 'shared/icon_save', active: favouriteable.favourites.exists?(user_id: current_user.id) %>
  <% end %>
<% end %>