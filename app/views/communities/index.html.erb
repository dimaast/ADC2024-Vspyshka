<% set_meta_tags( 
  title: "Сообщества",
  description: "Все студенческие организации Вышки от студентов и работников университета", 
  keywords: "Студорги, Студенческие организации, События, Мероприятия, Ивенты, Тусовки, Вышка, НИУ ВШЭ, ВШЭ" )%>

<div class="communities-title-container">
  <h1 class="communities-title">Сообщества</h1>
</div>

<div class="communities-filters-container">
  <div class="tags-filter-section">
    <%= render 'communities/tags_filter' %>
  </div>
</div>

<turbo-frame id="communities_list">
  <div class="communities-grid">
    <% @communities.each do |community| %>
      <%= render partial: 'community', locals: { community: community } %>
    <% end %>
  </div>
</turbo-frame>