<div class="CommunityCard" data-controller="community-card" data-community-id="<%= community.id %>" data-action="click->community-card#navigate">
  <div class="CommunityCard__image">
    <% if community.cover.present? %>
      <%= image_tag community.cover.url, alt: community.title %>
    <% else %>
      <div class="CommunityCard__placeholder">
        <%= community.title.first.upcase %>
      </div>
    <% end %>
  </div>
  
  <div class="CommunityCard__stats">
    <div class="CommunityCard__stat">
      <i class="fas fa-user"></i>
      <span><%= community.subscriptions.count %></span>
    </div>
    <div class="CommunityCard__stat">
      <i class="fas fa-equals"></i>
      <span><%= community.events.count %></span>
    </div>
  </div>
  
  <div class="CommunityCard__content">
    <h3 class="CommunityCard__title"><%= community.title %></h3>
    
    <% if community.tags.any? %>
      <div class="CommunityCard__tags">
        <% community.tags.each do |tag| %>
          <%= link_to tag.name, by_tag_communities_path(tag: tag.name), class: 'CommunityCard__tag' %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>