<div class="SearchForm" data-controller="search">
  <div class="SearchFormContent">
    <form action="<%= welcome_search_path %>" method="get" data-search-target="form">
      <input 
        class="SearchInput" 
        type="text" 
        placeholder="Введи запрос" 
        name="query" 
        data-search-target="query" 
        data-action="input->search#getAutocomplete"
        autocomplete="off"
      >
    </form>
    <button class="CloseButton" data-action="click->search#close">
      <i class="fas fa-times"></i>
    </button>
    
    <div class="SearchAutocomplete" data-search-target="autocomplete"></div>
  </div>
</div>