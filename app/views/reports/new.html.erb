<div class="ReportForm">
  <div class="ReportForm__header">
    <h1>Пожаловаться</h1>
    <p>Расскажите, почему вы считаете этот объект неприемлемым</p>
  </div>

  <div class="ReportForm__event-info">
    <% if @reportable.respond_to?(:title) %>
      <h3>Событие: <%= @reportable.title %></h3>
      <p><%= @reportable.body %></p>
    <% else %>
      <h3>Встреча</h3>
      <p><%= @reportable.body %></p>
    <% end %>
  </div>

  <%= form_with(model: @report, url: reports_path(reportable_type: params[:reportable_type], reportable_id: params[:reportable_id])) do |form| %>
    <% if @report.errors.any? %>
      <div class="error-message">
        <h2><%= pluralize(@report.errors.count, "error") %> prohibited this report from being saved:</h2>
        <ul>
          <% @report.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="FormRow">
      <%= form.label :reason, "Причина жалобы", class: "FormRow__label" %>
      <div class="FormRow__field">
        <%= form.text_area :reason, 
                        class: "FormInput FormInput--textarea", 
                        placeholder: "Опишите подробно причину вашей жалобы (минимум 10 символов)",
                        rows: 6 %>
      </div>
    </div>

    <div class="ReportForm__actions">
      <%= form.submit "Отправить жалобу", class: "Button Button--primary" %>
      <%= link_to "Отмена", @reportable, class: "Button Button--secondary" %>
    </div>
  <% end %>
</div>